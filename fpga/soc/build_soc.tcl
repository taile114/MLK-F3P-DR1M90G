# prepare_soc.py must run first. This builds the PS+AXI acquisition candidate.
set repo [file normalize [file join [file dirname [info script]] ../..]]
set out [file join $repo fpga uisrc out soc]
cd $out
file delete -force system.bit route_timing_summary.rpt route.area
if {[catch {
import_device dr1_90.db -package DR1M90GEG400 -speed 2
set f [open sources.list r]
set sources [split [string trim [read $f]] "\n"]
close $f
read_hdl -file [join $sources " "] -top soc_top
read_adc [file join $repo fpga uisrc 04_pin fpga_pin.adc]
# RS485 rpm pads: generated by prepare_soc.py from 04_pin/encoder_pin.adc and
# limited to the ports this top carries. A missing file means a stale project
# would drop the transceiver pins and fail the unconstrained-I/O bitgen gate.
if {![file exists [file join $out rs485_pin.adc]]} {
    error "rs485_pin.adc missing; re-run fpga/soc/prepare_soc.py"
}
read_adc [file join $out rs485_pin.adc]
read_sdc [file join $repo fpga soc timing.sdc]
read_sdc [file join $repo fpga uisrc 04_pin io_boundary.sdc]
optimize_rtl
optimize_gate
place
route
update_timing -mode final
report_timing_summary -file route_timing_summary.rpt
report_area -file route.area
check_timing -file check_timing.rpt -verbose
report_timing_ignored -file timing_ignored.rpt
report_timing_summary -include_ignored -file timing_include_ignored.rpt
set f [open check_timing.rpt r]
set checks [read $f]
close $f
# Gate on constraint completeness instead of a STA coverage percentage: TD
# leaves a set of PS-macro and vendor-interconnect timing endpoints unanalyzed,
# the vendor's own 20_axi_lite_register example reaches only 88.98% with fully
# valid constraints, and this project reaches 99.91%. Coverage is reported below.
foreach wanted {
    {There are 0 invalid constraints\.}
    {checking no clock\(0\)}
    {checking combinational loops\(0\)}
} {
    if {![regexp $wanted $checks]} {
        error "check_timing reports: $wanted"
    }
}
puts "NOTE board I/O budget: 1 ns placeholder on sensor pads (TBD on hardware)."
puts "NOTE reason: UART / SPI / I2C / LED pads are asynchronous; the budget only"
puts "NOTE gives every I/O endpoint a clocked reference for STA coverage."
puts "NOTE io_boundary.sdc also bounds the on-chip pad-to-register datapath at 10 ns."
puts "NOTE Board trace delay, external device setup/hold and sampling phase are TBD."
set f [open route_timing_summary.rpt r]
set timing [read $f]
close $f
if {![regexp {STA coverage *: *([0-9.]+%)} $timing unused coverage]} {
    error "STA coverage field missing"
}
puts "NOTE STA coverage = $coverage (reported, not gated; see the note above)."
if {![regexp {axi_clk} $timing]} { error "PS AXI clock missing" }
foreach label {SWNS HWNS} {
    if {![regexp [format {%s: *(-?[0-9]+\.[0-9]+)ns} $label] $timing unused slack]} {
        error "Timing field $label missing"
    }
    if {$slack < 0} { error "$label=$slack ns violates timing" }
}
bitgen -bit system.bit
} message]} {
    puts stderr "RESULT build_soc: FAIL $message"
    exit 1
}
puts "RESULT build_soc: PASS (RTL build; hardware connectivity requires board verification)"
exit
